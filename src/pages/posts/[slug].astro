---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import FormattedDate from '../../components/FormattedDate.astro';
import References from '../../components/References.astro';
import Base from '../../layouts/Base.astro';
import { AUTHOR, DEFAULT_HERO, DISCLOSURE, SITE_NAME } from '../../consts';
import { SITE_URL } from '../../data/entities';
import { fmt, lastUpdated } from '../../lib/dates';
import { orderRefs } from '../../lib/refs';
import { articleGraph } from '../../lib/schema';

export async function getStaticPaths() {
	const articles = await getCollection('articles');
	return articles
		.filter((a) => !a.data.draft)
		.map((a) => ({ params: { slug: a.id }, props: a }));
}
type Props = CollectionEntry<'articles'>;

const article = Astro.props;
const { Content, remarkPluginFrontmatter } = await render(article);
const { title, description, author, pubDate, evidence, tags, heroImage, takeaways, about, references, faq } = article.data;
const updated = lastUpdated(article);
const wasUpdated = updated.valueOf() !== pubDate.valueOf();
const path = `/posts/${article.id}/`;
const url = `${SITE_URL}${path}`;

// 參考文獻：依內文 [@key] 出現順序（由 cite-plugin 寫入 citeOrder）
const refs = orderRefs(references, (remarkPluginFrontmatter.citeOrder as string[] | undefined) ?? []);
const wordCount = (article.body ?? '').replace(/\s+/g, '').length;

// 未指定圖片時使用網站預設主視覺
const hero = heroImage
	? {
			src: heroImage.src,
			alt: heroImage.alt,
			width: heroImage.width,
			height: heroImage.height,
			credit: heroImage.credit,
			creditUrl: heroImage.creditUrl,
		}
	: {
			src: DEFAULT_HERO.src,
			alt: DEFAULT_HERO.alt,
			width: DEFAULT_HERO.width,
			height: DEFAULT_HERO.height,
			credit: `${DEFAULT_HERO.title} — ${DEFAULT_HERO.author}, ${DEFAULT_HERO.license}, via Wikimedia Commons`,
			creditUrl: DEFAULT_HERO.sourceUrl,
		};

const schema = articleGraph({
	path,
	title,
	description,
	image: hero.src,
	datePublished: pubDate,
	dateModified: updated,
	keywords: tags,
	evidence,
	about,
	references: refs,
	faq,
	wordCount,
});

const citeText = `${AUTHOR}（${updated.getUTCFullYear()}）。${title}。${SITE_NAME}。${url}（${fmt(updated)} 版）`;
---

<Base {title} {description} image={hero.src} type="article" {schema}>
	<article data-count-view={article.id}>
		<p class="crumbs small"><a href="/">首頁</a> › <a href="/posts/">文章</a> ›</p>
		<header>
			<h1>{title}</h1>
			<div class="meta">
				<span>作者：<a href="/about/" rel="author">{author}</a></span>
				<FormattedDate date={pubDate} label="發布" />
				{wasUpdated && <FormattedDate date={updated} label="更新" />}
				<span class="views" data-views={article.id}>–</span>
			</div>
			{(evidence.length > 0 || tags.length > 0) && (
				<ul class="tags">
					{evidence.map((e) => <li class="tag evidence">證據等級：{e}</li>)}
					{tags.map((t) => <li class="tag">{t}</li>)}
				</ul>
			)}
		</header>

		<figure class="article-hero">
			<img src={hero.src} alt={hero.alt} width={hero.width} height={hero.height} />
			{hero.credit && (
				<figcaption>
					圖片：{hero.creditUrl ? <a href={hero.creditUrl} rel="noopener" target="_blank">{hero.credit}</a> : hero.credit}
				</figcaption>
			)}
		</figure>

		{takeaways.length > 0 && (
			<aside class="takeaways" aria-labelledby="tk-h">
				<h2 id="tk-h">重點摘要</h2>
				<ul>
					{takeaways.map((t) => <li>{t}</li>)}
				</ul>
			</aside>
		)}

		<div class="prose">
			<Content />
		</div>

		{faq.length > 0 && (
			<section class="faq" aria-labelledby="faq-h">
				<h2 id="faq-h">常見問題</h2>
				{faq.map((f) => (
					<details>
						<summary>{f.q}</summary>
						<p>{f.a}</p>
					</details>
				))}
			</section>
		)}

		<References {refs} />

		<aside class="notice">
			<strong>利益揭露與聲明</strong><br />
			{DISCLOSURE}
		</aside>

		<section class="cite-this">
			<h2>引用本文</h2>
			<p>{citeText}</p>
		</section>
	</article>
</Base>

<style>
	.takeaways {
		background: var(--bg-card);
		border: 1px solid var(--line);
		border-left: 4px solid var(--accent);
		border-radius: 10px;
		padding: 0.9rem 1.1rem;
		margin: 1.5rem 0;
	}
	.takeaways h2 {
		font-size: 0.95rem;
		margin: 0 0 0.5rem;
		color: var(--link);
	}
	.takeaways ul {
		margin: 0;
		padding-left: 1.2rem;
		display: grid;
		gap: 0.35rem;
		font-size: 0.95rem;
	}
	.faq {
		margin-top: 2.5rem;
	}
	.faq h2 {
		font-size: 1.1rem;
	}
	.faq details {
		border-top: 1px solid var(--line);
		padding: 0.6rem 0;
	}
	.faq details:last-of-type {
		border-bottom: 1px solid var(--line);
	}
	.faq summary {
		cursor: pointer;
		font-weight: 600;
	}
	.faq p {
		margin: 0.5rem 0 0;
		color: var(--muted);
	}
	.cite-this {
		margin-top: 1.5rem;
		font-size: 0.85rem;
		color: var(--muted);
	}
	.cite-this h2 {
		font-size: 0.9rem;
		margin: 0 0 0.25rem;
	}
	.cite-this p {
		margin: 0;
		user-select: all;
	}
</style>
